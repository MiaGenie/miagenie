{
    "name": "miagenie/miagenie",
    "type": "project",
    "description": "MiaGenie App",
    "require": {
        "php": "^8.2",
        "inovector/mixpost-enterprise": "dev-main",
        "inovector/mixpost-pro-team": "dev-main",
        "laravel/framework": "^12.0",
        "laravel/horizon": "^5.15",
        "laravel/reverb": "^1.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "league/flysystem-sftp-v3": "^3.0",
        "sentry/sentry-laravel": "^4.9",
        "spatie/laravel-translatable": "^6.11",
        "openai-php/client": "^0.14.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.21",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0.1",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "repositories": {
        "inovector/mixpost-pro-team": {
            "type": "vcs",
            "url": "https://github.com/miagenie/mixpost-pro-team.git"
        },
        "inovector/mixpost-enterprise": {
            "type": "vcs",
            "url": "https://github.com/miagenie/mixpost-enterprise.git"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "if test $(composer show | grep -c mixpost) -ne 0; then php artisan mixpost:publish-assets --force=true; fi;",
            "if test $(composer show | grep -c mixpost) -ne 0; then php artisan mixpost-enterprise:publish-assets --force=true; fi;"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
