APP_NAME=Miagenie
APP_SERVICE=genie
APP_ENV=local
APP_KEY=base64:IhFbg4pY6mpGY6ET58MPhsKJgpDoQfDnX6iQn5MPN9M=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en-GB
APP_FALLBACK_LOCALE=en-GB
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=mixpost_db
DB_USERNAME=mixpost_db_user
DB_PASSWORD=mixpost_db_pass

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

#BROADCAST_CONNECTION=reverb
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=mixpost

MEMCACHED_HOST=127.0.0.1

# Redis connection setup
REDIS_HOST=redis
#REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=mixpost
MAIL_PASSWORD=password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="webmaster@miagenie.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS Credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# This is the path which Mixpost will use to load its core routes and assets
MIXPOST_CORE_PATH=m

# Define log channel
MIXPOST_LOG_CHANNEL=mixpost

# The disk on which to store added files. Disks: "public", "s3". For "s3" you should fill in the AWS_* credentials below.
MIXPOST_DISK=public

# Sentry
SENTRY_LARAVEL_DSN=null

REVERB_APP_ID=919461
REVERB_APP_KEY=sxefekgnlpjijcpnkbeb
REVERB_APP_SECRET=magnsrq2pacqd441nwqe
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

SAIL_XDEBUG_CONFIG="client_host=host.docker.internal"
SAIL_XDEBUG_MODE=develop,debug
